<% const placementActive=placementRows.length>0; const sections=placementActive?[{caption:'Semifinalists · league results',rows:leagueRows.slice(0,4),offset:0},{caption:'Places 5–'+(placementRows.length+4)+' · placement results',rows:placementRows,offset:4}]:[{caption:null,rows:leagueRows,offset:0}]; %>
<section class="standings-section"><div class="sectionhead"><h2><%= placementActive?'Current standings':'League standings' %></h2><% if(placementActive){ %><span>Placement round in progress</span><% } %></div>
<table class="standings-table" id="current-standings"><thead><tr><th class="rank" scope="col">#</th><th class="team-column" scope="col">Team</th><th class="points" scope="col">Pts</th><th scope="col">W</th><th scope="col">D</th><th scope="col">L</th><th scope="col">+/−</th></tr></thead>
<% for(const section of sections){ %><tbody><% if(section.caption){ %><tr class="standings-group"><th colspan="7" scope="rowgroup"><%= section.caption %></th></tr><% } %>
<% section.rows.forEach((s,i)=>{ %><tr data-standing-team="<%= s.team.id %>"><td class="rank"><%= i+1+section.offset %></td><td class="teamcell"><%- include('_team',{team:s.team,size:'',vertical:false}) %></td><td class="pts"><%= s.leaguePoints %></td><td><%= s.wins %></td><td><%= s.draws %></td><td><%= s.losses %></td><td class="muted"><%= s.pointDifference>0?'+':'' %><%= s.pointDifference %></td></tr><% }); %></tbody><% } %></table>
<% if(placementActive){ %><p class="standings-note">Top four shown in league seed order · places 5–<%= placementRows.length+4 %> provisional</p><% } %></section>
