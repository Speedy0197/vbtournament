<article class="match-row">
<div class="match-row-meta"><strong><%= ui.time(m)||ui.phase(m) %></strong><span>Court <%= m.court %><% if(ui.time(m)&&m.phase!=='group'){ %> · <%= ui.phase(m) %><% } %></span></div>
<div class="match-row-teams"><%- include('_team',{team:ui.team(m,1),size:'small',vertical:false}) %><%- include('_team',{team:ui.team(m,2),size:'small',vertical:false}) %><%- include('_referee',{m}) %></div>
<div class="match-row-score"><% if(m.status==='done'||m.sets.length){ %><%- include('_score',{m}) %><% }else{ %><span class="status">Scheduled</span><% } %></div>
<% if(typeof admin!=='undefined' && admin){ %><div class="match-row-actions"><% if(ui.blocked(m,allMatches)){ %><span class="muted">Waiting</span><% }else{ %><a href="/admin/match/<%= m.id %>/score" class="btn btn-secondary btn-sm"><%= m.status==='done'?'Edit result':'Score' %></a><% } %></div><% } %>
</article>
