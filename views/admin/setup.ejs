<%- include('../_header',{title:'Teams & setup'}) %>
<div class="admin-head"><div><h1>Teams &amp; setup</h1><p>Manage the tournament before play starts.</p></div><a class="btn btn-secondary btn-sm" href="/admin">← Match desk</a></div>
<% if(error){ %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
<div class="admin-progress"><strong><%= canSetup?'Setup open':'Setup locked' %></strong> · <%= canSetup?'No active games or saved scores.':'The tournament has started. Logos can still be updated.' %></div>
<form id="roster-form" method="POST" action="/admin/setup">
<input type="hidden" name="rosterVersion" value="<%= rosterVersion %>">
<div class="sectionhead"><h2>Team roster</h2><span>Six or seven teams</span></div>
<div class="logo-grid" id="team-roster">
<% for(const team of teams){ %><article class="logo-tile" data-roster-team>
<%- include('../_team',{team,size:'hero',vertical:true}) %>
<input type="hidden" name="teamId" value="<%= team.id %>">
<label class="sr-only" for="name-<%= team.id %>">Team name</label><input id="name-<%= team.id %>" type="text" name="name" maxlength="100" value="<%= team.name %>" required <%= canSetup?'':'readonly' %>>
<div class="team-actions"><label class="btn btn-secondary btn-sm">Change logo<input type="file" name="icon" accept="image/png,image/jpeg,image/gif,image/webp" form="icon-form-<%= team.id %>" data-icon-upload hidden></label>
<% if(canSetup){ %><button type="button" class="btn btn-ghost btn-sm" data-remove-team>Remove</button><% } %></div>
</article><% } %>
</div>
<% if(canSetup){ %>
<template id="new-team-template"><article class="logo-tile" data-roster-team><span class="team-logo hero logo-placeholder">+</span><label>Team name<input name="name" type="text" maxlength="100" required placeholder="New team"></label><input name="teamId" type="hidden" value=""><p class="help">Upload a logo after saving.</p><button type="button" class="btn btn-ghost btn-sm" data-remove-team>Remove</button></article></template>
<div class="management-content"><p class="help" id="roster-count" role="status">Keep six or seven teams. Removed teams leave the tournament.</p><button type="button" class="btn btn-secondary btn-sm" id="add-team">Add team</button></div>
<section class="management"><h2>Save roster &amp; rebuild schedule</h2><p class="help">Keep existing team IDs and logos. Roster changes replace the schedule and rebalance referee duties.</p>
<label class="check-label"><input type="checkbox" name="confirmReset" value="yes" required>I confirm: save these teams and replace the current schedule.</label><button class="btn" id="save-roster">Save teams &amp; regenerate schedule</button></section>
<% } %></form>
<p id="icon-upload-status" role="status" aria-live="polite" class="help">Photos are resized automatically. Maximum original size: 5 MiB. Save roster changes before uploading logos.</p>
<% for(const team of teams){ %><form id="icon-form-<%= team.id %>" method="POST" action="/admin/team/<%= team.id %>/icon" enctype="multipart/form-data"></form><% } %>
<% if(canSetup && hasSchedule){ %><section class="management"><form method="POST" action="/admin/generate-schedule"><h2>Reset &amp; regenerate schedule</h2><p class="help">Use the currently saved roster and logos. Unsaved roster edits above are not applied.</p><label class="check-label"><input type="checkbox" name="confirmReset" value="yes" required>Replace pending matches and referee assignments.</label><button class="btn btn-secondary">Reset &amp; regenerate schedule</button></form></section><% } %>
<%- include('../_footer') %>
