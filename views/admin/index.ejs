<%- include('../_header',{title:'Admin'}) %>
<% const allMatches=groupMatches.concat(bracketMatches).sort((a,b)=>a.id-b.id); const finished=ui.finalResults(teams,allMatches); const courtMatches=ui.nextByCourt(allMatches).filter(m=>m.status!=='done'); const awaiting=ui.adminQueue(allMatches); const completed=allMatches.filter(m=>m.status==='done').reverse(); %>
<div class="admin-head"><div><h1>Match desk</h1><p><%= finished?'The tournament is complete. Review or correct results below.':'Enter results and keep both courts moving.' %></p></div><div class="admin-actions"><a class="btn btn-secondary btn-sm" href="/admin/setup">Teams &amp; setup</a><a class="btn btn-secondary btn-sm" href="/admin/print" target="_blank">Print schedule</a><a class="btn btn-ghost btn-sm" href="/admin/logout">Logout</a></div></div>
<% if(error){ %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
<% if(finished){ %><%- include('../_final_standings',{finished}) %><% } %>
<% if(!finished){ %><div class="admin-progress"><%= groupMatches.filter(m=>m.status==='done').length %> of <%= groupMatches.length %> league games completed</div><% } %>
<% if(groupMatches.some(m=>m.status!=='done')){ %><p class="help">Estimated times · 5-minute breaks. Save both court results promptly to update the next round together.</p><% } %>
<% if(courtMatches.length){ %><div class="courts"><% for(const m of courtMatches){ %><%- include('../_court',{m,admin:true,allMatches}) %><% } %></div><% }else{ %><div class="empty"><% if(allMatches.length){ %>All scheduled games have results. Completed games can be corrected below.<% }else{ %>No games scheduled. <a href="/admin/setup">Open tournament setup</a> or generate the schedule below.<% } %></div><% } %>
<% if(awaiting.length){ %><section aria-labelledby="awaiting-results"><div class="sectionhead"><h2 id="awaiting-results">Awaiting results</h2><span>Ready games first</span></div><% for(const m of awaiting){ %><%- include('../_match_row',{m,admin:true,allMatches}) %><% } %></section><% } %>
<% const semis=bracketMatches.filter(m=>m.phase==='gold_sf'); const needsBracket=allGroupDone&&(!semis.length||(semis.length===2&&semis.every(m=>m.status==='done')&&!bracketMatches.some(m=>m.phase==='gold_final'))); %>
<% if(needsBracket){ %><form action="/admin/advance-bracket" method="POST" class="section-space"><button class="btn"><%= bracketMatches.length?'Retry bracket creation':'Seed semifinals' %></button></form><% } %>
<% if(completed.length){ %><details class="section-space"><summary>Completed games (<%= completed.length %>)</summary><% for(const m of completed){ %><%- include('../_match_row',{m,admin:true,allMatches}) %><% } %></details><% } %>
<% if(bracketMatches.length&&!finished){ %><%- include('../_placement_standings',{placementStandings}) %><% } %>
<details class="section-space"><summary>League standings</summary><%- include('../_standings',{rows:standings.A,caption:'League standings',offset:0,placement:false}) %></details>
<details class="management" <%= groupMatches.length?'':'open' %>><summary>Tournament setup · before play</summary>
<div class="management-content"><span>Manage the roster, logos and schedule.</span><a class="btn btn-secondary btn-sm" href="/admin/setup">Edit teams</a></div>
<% if(canSetup){ %><%- include('_schedule_form',{teams,groupMatches,mode}) %>
<% if(canWithdraw){ %><details class="withdrawal"><summary>Six-team fallback · a team is missing</summary><p class="help">Remove the missing team and rebuild the league with balanced referee duties. Remaining teams keep their logos.</p><form method="POST" action="/admin/withdraw-team"><label for="missing-team">Missing team</label><select id="missing-team" name="teamId" required><option value="">Select a team</option><% for(const team of teams){ %><option value="<%= team.id %>"><%= team.name %></option><% } %></select><label class="check-label"><input type="checkbox" name="confirmReset" value="yes" required>Confirm the withdrawal and replace the schedule.</label><button class="btn btn-secondary btn-sm">Use six-team fallback</button></form></details><% } %>
<% }else{ %><p class="help">Roster and schedule changes are locked because play has started. Logos can still be updated.</p><% } %>
</details><%- include('../_footer') %>
