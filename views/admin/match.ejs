<%- include('../_header',{title:'Save result'}) %>
<div class="score-shell"><div class="score-meta"><strong>Court <%= match.court %> · <%= ui.phase(match) %></strong><time><%= ui.time(match) %></time></div>
<% if(error){ %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
<% if(typeof locked!=='undefined'&&locked){ %><p class="alert alert-info">This result is locked because the next round has been decided.</p><% } %>
<% if(match.status==='done'){ %><p class="alert alert-info">Correct the scores and save. Unplayed bracket games update automatically. Changes that would replace a team in a game that has started or has scores are blocked.</p><% } %>
<div class="score-panel"><%- include('../_referee',{m:match}) %>
<form method="POST"><input type="hidden" name="scoreVersion" value="<%= scoreVersion %>"><table class="score-table"><thead><tr><th><span class="sr-only">Set</span></th><th><%- include('../_team',{team:ui.team(match,1),size:'hero',vertical:true}) %></th><th><%- include('../_team',{team:ui.team(match,2),size:'hero',vertical:true}) %></th></tr></thead><tbody>
<% const timed=match.scoring_format==='timed'; const numbers=timed?Array.from({length:match.timed_periods||1},(_,i)=>i+1):match.fixed_sets===2?[1,2]:match.sets_to_win===1?[1]:[1,2,3]; %>
<% for(const n of numbers){ const s=match.sets.find(s=>s.set_number===n)||{}; %><tr><td>Set <%= n %><span class="duration"><%= timed?'10 minutes':n===3?'If needed':'' %></span></td>
<% for(const side of [1,2]){ %><td><input type="number" inputmode="numeric" name="s<%= n %>t<%= side %>" min="0" max="9999" aria-label="<%= match['team'+side+'_name'] %> score <%= n %>" value="<%= s['team'+side+'_score']!=null?s['team'+side+'_score']:'' %>" placeholder="–" <%= typeof locked!=='undefined'&&locked?'readonly':'' %>></td><% } %>
</tr><% } %></tbody></table>
<% if(timed&&match.status!=='done'){ %><p class="help">Save promptly when the game ends. The next round is estimated 5 minutes after both court results are saved.</p><% } %>
<div class="score-actions"><button class="btn" <%= typeof locked!=='undefined'&&locked?'disabled':'' %>>Save result</button><a href="/admin" class="btn btn-secondary">Back</a></div>
</form></div>
<details class="score-help"><summary>Scoring reminder</summary><p>Save after any completed set and leave unplayed sets blank. Enter the points actually played, including shorter or extended sets.<% if(timed){ %> Finish the rally at each buzzer; play one deciding rally if tied. The match finishes after both timed sets; a 1–1 draw is allowed.<% }else{ %> The match finishes after <%= match.fixed_sets===2?'both sets':(match.sets_to_win||2)+' set wins' %>. Leave set 3 blank after 2–0.<% } %></p></details>
</div><%- include('../_footer') %>
